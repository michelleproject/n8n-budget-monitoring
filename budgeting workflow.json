      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const budgets = {\n  \"Groceries\": 800000,\n  \"Health\": 500000,\n  \"Shopping\": 500000,\n  \"Transport\": 600000,\n  \"Utilities\": 600000,\n  \"Subscriptions\": 400000,\n  \"Food & Drink\": 500000\n};\n\nconst rows = $('Aggregate by category').all().map(i => i.json);\n\nconst overBudget = [];\nconst lines = [];\n\nfor (const row of rows) {\n  const limit = budgets[row.Category];\n  const total = Number(row.Total) || 0;\n  const count = row[\"Transaction Count\"];\n\n  if (limit && total > limit) {\n    overBudget.push(row.Category);\n    lines.push(`[OVER] ${row.Category}: ${total.toLocaleString('id-ID')} of ${limit.toLocaleString('id-ID')} - over by ${(total - limit).toLocaleString('id-ID')} (${count} transactions)`);\n  } else if (!limit) {\n    lines.push(`${row.Category}: ${total.toLocaleString('id-ID')} (NO LIMIT SET)`);\n  } else {\n    lines.push(`${row.Category}: ${total.toLocaleString('id-ID')} of ${limit.toLocaleString('id-ID')} (${count} transactions)`);\n  }\n}\n\nconst grandTotal = rows.reduce((sum, r) => sum + (Number(r.Total) || 0), 0);\n\nconst subject = overBudget.length\n  ? `Budget alert: ${overBudget.length} categor${overBudget.length === 1 ? 'y' : 'ies'} over limit`\n  : `Weekly budget summary - everything within limit`;\n\nconst body = [\n  `Total spending: ${grandTotal.toLocaleString('id-ID')}`,\n  '',\n  ...lines,\n  '',\n  overBudget.length ? `Over budget: ${overBudget.join(', ')}` : 'Nothing over budget this period.'\n].join('\\n');\n\nreturn [{ json: { subject, body, overBudgetCount: overBudget.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -112
      ],
      "id": "a6d1bc92-ab50-4f30-8f1a-59395691995d",
      "name": "Check budget limits"
    },
    {
      "parameters": {
        "jsCode": "const totals = {};\n\nfor (const item of $input.all()) {\n  const category = item.json.Category?.trim();\n  const amount = Number(item.json.Amount) || 0;\n  if (!category) continue;\n\n  if (!totals[category]) {\n    totals[category] = { Category: category, Total: 0, \"Transaction Count\": 0 };\n  }\n  totals[category].Total += amount;\n  totals[category][\"Transaction Count\"] += 1;\n}\n\nreturn Object.values(totals)\n  .sort((a, b) => b.Total - a.Total)\n  .map(json => ({ json }));"
      },
