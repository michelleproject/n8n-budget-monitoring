    {
      "parameters": {
        "jsCode": "const totals = {};\n\nfor (const item of $input.all()) {\n  const category = item.json.類別?.trim();\n  const amount = Number(item.json.金額) || 0;\n  if (!category) continue;\n\n  if (!totals[category]) {\n    totals[category] = { 類別: category, 總金額: 0, \"交易筆數\": 0 };\n  }\n  totals[category].總金額 += amount;\n  totals[category][\"交易筆數\"] += 1;\n}\n\nreturn Object.values(totals)\n  .sort((a, b) => b.總金額 - a.總金額)\n  .map(json => ({ json }));"
      },
