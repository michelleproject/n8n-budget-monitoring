      "name": "Get NTD row(s) in sheet"
    },
    {
      "parameters": {
        "jsCode": "const budgets = {\n  \"Groceries\": 1200,\n  \"Health\": 500,\n  \"Shopping\": 1500,\n  \"Transport\": 150,\n  \"Utilities\": 1200,\n  \"Subscriptions\": 300,\n  \"Food & Drink\": 400,\n  \"Entertainment\": 1000\n};\n\nconst rows = $('Aggregate by category').all().map(i => i.json);\n\nconst overBudget = [];\nconst lines = [];\nconst formatTwd = amount => `NT$${new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(amount)}`;\n\nfor (const row of rows) {\n  const limit = budgets[row.類別];\n  const total = Number(row.總金額) || 0;\n  const count = row[\"交易筆數\"];\n\n  if (limit && total > limit) {\n    overBudget.push(row.類別);\n    lines.push(`[OVER] ${row.類別}: ${formatTwd(total)} of ${formatTwd(limit)} - over by ${formatTwd(total - limit)} (${count} transactions)`);\n  } else if (!limit) {\n    lines.push(`${row.類別}: ${formatTwd(total)} (NO LIMIT SET)`);\n  } else {\n    lines.push(`${row.類別}: ${formatTwd(total)} of ${formatTwd(limit)} (${count} transactions)`);\n  }\n}\n\nconst grandTotal = rows.reduce((sum, r) => sum + (Number(r.總金額) || 0), 0);\n\nconst subject = overBudget.length\n  ? `Budget alert: ${overBudget.length} categor${overBudget.length === 1 ? 'y' : 'ies'} over limit`\n  : `Weekly budget summary - everything within limit`;\n\nconst body = [\n  `Total spending: ${formatTwd(grandTotal)}`,\n  '',\n  ...lines,\n  '',\n  overBudget.length ? `Over budget: ${overBudget.join(', ')}` : 'Nothing over budget this period.'\n].join('\\n');\n\nreturn [{ json: { subject, body, overBudgetCount: overBudget.length } }];"
      },
